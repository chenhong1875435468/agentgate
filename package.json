{
  "name": "agentgate",
  "version": "0.1.0",
  "description": "Reliability gate for AI agents. Measures Pass^k, not Mean@k.",
  "type": "module",
  "bin": {
    "agentgate": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run pretest && node --test \"dist-test/test/**/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test",
    "example": "npm run build && node dist/cli.js check --config examples/agentgate.yml --quiet"
  },
  "keywords": [
    "ai-agent",
    "llm",
    "reliability",
    "consistency",
    "ci-cd",
    "evaluation",
    "pass-k",
    "llm-as-judge",
    "regression-testing",
    "llm-ops"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}